# Copie para ".env" e ajuste conforme necessário.
# A Oficina não guarda dados nem tem login -- ela só aponta pros seus outros
# apps, então quase tudo aqui é opcional. Os defaults já apontam pras URLs
# reais publicadas (ver url_default em projects.py); essas variáveis só
# existem pra permitir sobrescrever, por exemplo, pra testar contra uma
# versão local antes de publicar.

LIFE_BUILDER_URL=https://life-builder-assistant.onrender.com/
PASSWORD_GENERATOR_URL=https://password-generator-6wq7.onrender.com/
DASHBOARDS_REAL_ESTATE_URL=https://dashboards-real-estate.onrender.com/
KRIPTA_HAUS_URL=https://kripta-haus.vercel.app/

# Porta em que a própria Oficina escuta.
PORT=5050

# "1" = modo debug do Flask. Deixe "0" em produção.
FLASK_DEBUG=0
